  <!-- 核心即時 CMS 腳本 -->
  <script>
    // 請替換為您部署的 GAS WebApp URL
    const GAS_API_URL = "https://script.google.com/macros/s/AKfycbwb_HtRnt004MBuljBVL8ob7LbFFN7w-Om_UHbJjD-tnsFik7J3D-ChDR1r05nqIdcITg/exec";

    let isEditing = false;
    let adminToken = "";
    let currentUploadArticleIndex = null;

    // 預設專題與文章資料 (含戴春暉醫師與何應瑞教授專題)
    let siteState = {
      texts: {
        siteTitle: "財團法人RBI 瑞金抗齡照護研究教育基金會",
        heroTitle: "推動抗齡照護學術研究與教育\n實踐巴金森病友自立與家庭安寧",
        heroSubtitle: "促進人類生理、心理及社會的美好安寧狀態。匯聚醫療手術進展、神經新生科學、物理運動訓練與國際病友組織資源，攜手迎向尊嚴生活。",
        aboutP1: "財團法人RBI 瑞金抗齡照護研究教育基金會（簡稱 R 基金會），以推動人類抗齡照護之學術研究及教育為目的，促進人類生理、心理及社會都處於一種美好安寧的健康狀態為宗旨。",
        aboutP2: "本會積極鼓勵並推廣抗齡醫學（包含巴金森氏症、失智症、抗衰老及醫美等相關醫學）及長期照護研究發展，強化國內外學術交流並培育專業照護人才，讓照護不再只是負擔，而是具有科學支撐的賦能過程。"
      },
      articles: [
        {
          tag: "神經外科 ‧ 手術前沿",
          title: "台大戴春暉醫師：aDBS 智慧精準深腦刺激手術",
          desc: "深入解析感知型腦刺激儀如何即時監測神經異常放電，精準控電減少異動症與電量消耗。",
          img: "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=600&auto=format&fit=crop&q=60"
        },
        {
          tag: "生化醫學 ‧ 新藥科研",
          title: "中山醫何應瑞教授：神經新生與巴金森氏症解方",
          desc: "探討頭孢曲松（Ceftriaxone）誘導腦衍生神經滋長因子，促進多巴胺神經元再生之長期臨床研究。",
          img: "https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?w=600&auto=format&fit=crop&q=60"
        },
        {
          tag: "物理治療 ‧ 運動處方",
          title: "物理治療師：掌握三要件，開啟巴金森黃金運動期",
          desc: "結合平衡木、動中覺察與拳擊訓練，有效降低跌倒風險，提升動作敏捷與日常生活自立能力。",
          img: "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=600&auto=format&fit=crop&q=60"
        }
      ]
    };

    // 初始化載入
    async function initData() {
      try {
        const res = await fetch(GAS_API_URL);
        const data = await res.json();
        if (data && data.texts) {
          siteState = data;
        }
      } catch (err) {
        console.warn("使用預設資料載入：", err);
      }
      renderSite();
    }

    // 渲染全站
    function renderSite() {
      // 填入綁定 data-key 的文字
      document.querySelectorAll("[data-key]").forEach(el => {
        const key = el.getAttribute("data-key");
        if (siteState.texts[key] !== undefined) {
          el.innerText = siteState.texts[key];
        }
      });

      // 渲染專家專題卡片
      const container = document.getElementById("articlesContainer");
      container.innerHTML = "";
      siteState.articles.forEach((art, idx) => {
        const card = document.createElement("div");
        card.className = "bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200 flex flex-col justify-between relative";
        card.innerHTML = `
          <div>
            <div class="relative h-48 w-full bg-slate-100 overflow-hidden">
              <img src="${art.img}" class="w-full h-full object-cover" id="art-img-${idx}">
              ${isEditing ? `
                <button onclick="triggerImageUpload(${idx})" class="absolute inset-0 bg-slate-900/60 text-rbi-goldLight font-bold flex items-center justify-center opacity-90 hover:opacity-100 transition text-sm">
                  更換圖片 (直傳雲端硬碟)
                </button>
              ` : ''}
            </div>
            <div class="p-6 space-y-2">
              <span class="inline-block px-2.5 py-0.5 bg-amber-50 text-rbi-goldDark border border-amber-200 text-xs font-bold rounded"
                ${isEditing ? 'contenteditable="true"' : ''} onblur="updateArticleField(${idx}, 'tag', this.innerText)">${art.tag}</span>
              <h3 class="text-xl font-bold text-rbi-navy"
                ${isEditing ? 'contenteditable="true"' : ''} onblur="updateArticleField(${idx}, 'title', this.innerText)">${art.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed"
                ${isEditing ? 'contenteditable="true"' : ''} onblur="updateArticleField(${idx}, 'desc', this.innerText)">${art.desc}</p>
            </div>
          </div>
          ${isEditing ? `
            <div class="p-4 bg-slate-50 border-t border-slate-100 flex justify-end">
              <button onclick="deleteArticle(${idx})" class="text-xs text-red-600 font-bold hover:underline">刪除此卡片</button>
            </div>
          ` : ''}
        `;
        container.appendChild(card);
      });
    }

    // 編輯模式開關
    function toggleEditMode() {
      if (!isEditing) {
        const pwd = prompt("請輸入管理者金鑰 (預設: RBI_ADMIN_2026)：");
        if (!pwd) return;
        adminToken = pwd;
        isEditing = true;
        document.body.classList.add("editing");
        document.getElementById("toggleEditBtn").classList.add("hidden");
        document.getElementById("saveBtn").classList.remove("hidden");
        document.getElementById("exitEditBtn").classList.remove("hidden");
        document.getElementById("editBadge").classList.remove("hidden");
        document.getElementById("addArticleBtn").classList.remove("hidden");

        document.querySelectorAll("[data-key]").forEach(el => el.setAttribute("contenteditable", "true"));
        renderSite();
      }
    }

    function exitEditMode() {
      isEditing = false;
      document.body.classList.remove("editing");
      document.getElementById("toggleEditBtn").classList.remove("hidden");
      document.getElementById("saveBtn").classList.add("hidden");
      document.getElementById("exitEditBtn").classList.add("hidden");
      document.getElementById("editBadge").classList.add("hidden");
      document.getElementById("addArticleBtn").classList.add("hidden");
      document.querySelectorAll("[data-key]").forEach(el => el.removeAttribute("contenteditable"));
      renderSite();
    }

    // 新增專題卡片
    function addNewArticle() {
      siteState.articles.unshift({
        tag: "最新消息 / 專題",
        title: "請點此編輯新標題",
        desc: "請點此輸入內文簡述...",
        img: "https://images.unsplash.com/photo-1505751172876-fa1923c5c528?w=600&auto=format&fit=crop&q=60"
      });
      renderSite();
    }

    function deleteArticle(index) {
      if (confirm("確定要刪除這張專題報導嗎？")) {
        siteState.articles.splice(index, 1);
        renderSite();
      }
    }

    function updateArticleField(index, field, value) {
      siteState.articles[index][field] = value.trim();
    }

    // 圖片上傳至 Google 雲端硬碟
    function triggerImageUpload(index) {
      currentUploadArticleIndex = index;
      document.getElementById("imageUploadInput").click();
    }

    async function uploadImageToDrive(input) {
      if (!input.files || !input.files[0]) return;
      const file = input.files[0];
      const reader = new FileReader();

      const saveBtn = document.getElementById("saveBtn");
      saveBtn.innerText = "圖片直傳雲端硬碟中...";
      saveBtn.disabled = true;

      reader.onload = async function() {
        try {
          const res = await fetch(GAS_API_URL, {
            method: "POST",
            headers: { "Content-Type": "text/plain;charset=utf-8" },
            body: JSON.stringify({
              action: "uploadImage",
              password: adminToken,
              base64: reader.result,
              fileName: file.name,
              mimeType: file.type
            })
          });
          const data = await res.json();
          if (data.success && data.url) {
            siteState.articles[currentUploadArticleIndex].img = data.url;
            renderSite();
            alert("圖片已成功上傳至 Google 雲端硬碟並套用！");
          } else {
            alert("上傳失敗：" + data.message);
          }
        } catch (e) {
          alert("上傳失敗，請檢查網路連接。");
        } finally {
          saveBtn.innerText = "即刻儲存並同步至試算表";
          saveBtn.disabled = false;
          input.value = "";
        }
      };
      reader.readAsDataURL(file);
    }

    // 儲存全站變更至 Google 試算表
    async function saveAllContent() {
      document.querySelectorAll("[data-key]").forEach(el => {
        const key = el.getAttribute("data-key");
        siteState.texts[key] = el.innerText;
      });

      const saveBtn = document.getElementById("saveBtn");
      saveBtn.innerText = "儲存中...";
      saveBtn.disabled = true;

      try {
        const res = await fetch(GAS_API_URL, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({
            action: "saveSiteData",
            password: adminToken,
            data: siteState
          })
        });
        const result = await res.json();
        if (result.success) {
          alert("儲存成功！所有內容已同步至 Google 試算表。");
          exitEditMode();
        } else {
          alert("儲存失敗：" + result.message);
        }
      } catch (err) {
        alert("無法連線至 Google 試算表伺服器。");
      } finally {
        saveBtn.innerText = "即刻儲存並同步至試算表";
        saveBtn.disabled = false;
      }
    }

    // 送出諮詢至試算表
    async function handleInquirySubmit(e) {
      e.preventDefault();
      const btn = document.getElementById("inqSubmitBtn");
      btn.innerText = "傳送中...";
      btn.disabled = true;

      const payload = {
        action: "submitInquiry",
        name: document.getElementById("inqName").value,
        phone: document.getElementById("inqPhone").value,
        message: document.getElementById("inqMsg").value
      };

      try {
        const res = await fetch(GAS_API_URL, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        alert(data.message);
        document.getElementById("inquiryForm").reset();
      } catch (err) {
        alert("網路傳送錯誤，請稍後再試。");
      } finally {
        btn.innerText = "確認送出";
        btn.disabled = false;
      }
    }

    initData();
  </script>
