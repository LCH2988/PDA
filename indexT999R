        title: "戰勝巴金森氏症講座：中醫與巴金森氏症治療",
        summary: "中醫輔助調理肝腎氣血、針灸活絡經絡氣血，與西醫藥物相輔相成，改善肢體僵硬及腸胃機能。",
        content: "中西醫整合治療講座中指出，中醫辨證視巴金森為肝腎陰虛、氣血虧虛。在西醫多巴胺規律治療基礎上，輔以中藥調理腸胃脾胃氣血與針灸刺激頭皮神經穴位，有助改善頑固便秘與舒緩肌張力。"
      },
      {
        id: 29,
        tagType: "專家專訪",
        category: "medical",
        categoryLabel: "腸腦健康",
        title: "中西醫的共識：巴金森氏症可能與腸胃健康有關",
        summary: "最新腸腦軸（Gut-Brain Axis）研究指出，異常 α-突觸核蛋白可能最早起源於腸道神經叢！",
        content: "近年醫學界重要發現：許多病友在出現手抖前十多年即有嚴重慢性便秘。中醫一向重視脾胃為後天之本，這與現代神經學倡導藉由腸道益生菌平衡與抗發炎飲食來延緩神經退化的理論不謀而合。"
      }
    ];

    // 替換成您剛剛部署好的 GAS Web App URL
    const GAS_API_URL = "https://script.google.com/macros/s/AKfycbx1lJ41QU6nxeVf_ReqmloVIQhTdHJwtkXEh-jkkfccRrUWpT0soaN-l2ggOwP6k2vZvg/exec";

    // 從 Google 試算表撈取文章
    async function loadArticlesFromGAS(category = 'all', keyword = '') {
      try {
        const url = `${GAS_API_URL}?action=getArticles&category=${category}&search=${encodeURIComponent(keyword)}`;
        const response = await fetch(url);
        const result = await response.json();
        
        if (result.success) {
          console.log('成功從 Google 試算表載入文章：', result.data);
          // 將資料丟入網頁的渲染函式
          renderArticlesWithData(result.data);
        }
      } catch (error) {
        console.error('GAS API 連線失敗:', error);
      }
    }


    // 元素快取
    const articlesGrid = document.getElementById("articles-grid");
    const searchInput = document.getElementById("search-input");
    const emptyState = document.getElementById("empty-state");
    const totalCountSpan = document.getElementById("total-count");
    const filterButtons = document.querySelectorAll(".filter-btn");

    // Modal 元素
    const modal = document.getElementById("article-modal");
    const modalCloseBtn = document.getElementById("modal-close-btn");
    const modalConfirmBtn = document.getElementById("modal-confirm-btn");
    const modalTitle = document.getElementById("modal-title");
    const modalTag = document.getElementById("modal-tag");
    const modalCategoryName = document.getElementById("modal-category-name");
    const modalContent = document.getElementById("modal-content");

    // 當前狀態
    let currentCategory = "all";
    let searchKeyword = "";

    // 初始化總數
    totalCountSpan.textContent = articlesData.length;

    // 渲染文章列表
    function renderArticles() {
      const filtered = articlesData.filter(item => {
        const matchCat = (currentCategory === "all") || (item.category === currentCategory);
        const matchSearch = searchKeyword.trim() === "" || 
                            item.title.toLowerCase().includes(searchKeyword.toLowerCase()) || 
                            item.summary.toLowerCase().includes(searchKeyword.toLowerCase()) ||
                            item.content.toLowerCase().includes(searchKeyword.toLowerCase());
        return matchCat && matchSearch;
      });

      if (filtered.length === 0) {
        articlesGrid.innerHTML = "";
        emptyState.classList.remove("hidden");
        return;
      }

      emptyState.classList.add("hidden");
      articlesGrid.innerHTML = filtered.map(item => `
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 flex flex-col justify-between hover:shadow-xl hover:border-teal-300 transition-all duration-200 group cursor-pointer" onclick="openModalById(${item.id})">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full ${getTagClass(item.tagType)}">
                ${item.tagType}
              </span>
              <span class="text-xs text-slate-500 font-medium">
                ${item.categoryLabel}
              </span>
            </div>
            <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-teal-700 transition line-clamp-2 leading-snug mb-2.5">
              ${item.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed mb-4">
              ${item.summary}
            </p>
          </div>
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span class="inline-flex items-center gap-1 text-teal-700 font-semibold group-hover:translate-x-1 transition duration-200">
              深入閱讀 <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </span>
            <span class="text-[11px] text-slate-400">專題專訪</span>
          </div>
        </div>
      `).join("");

      // 重新初始化圖標
      lucide.createIcons();
    }

    function getTagClass(tag) {
      switch (tag) {
        case "專家專訪":
          return "bg-teal-50 text-teal-700 border border-teal-200";
        case "專家好文":
          return "bg-sky-50 text-sky-700 border border-sky-200";
        case "活動影片":
          return "bg-rose-50 text-rose-700 border border-rose-200";
        case "活動報導":
          return "bg-amber-50 text-amber-700 border border-amber-200";
        default:
          return "bg-slate-100 text-slate-700";
      }
    }

    // 開啟 Modal 視窗
    window.openModalById = function(id) {
      const item = articlesData.find(a => a.id === id);
      if (!item) return;

      modalTitle.textContent = item.title;
      modalTag.textContent = item.tagType;
      modalCategoryName.textContent = item.categoryLabel;
      modalContent.innerHTML = `
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/70 text-slate-700 font-medium text-xs sm:text-sm">
          <strong>核心摘要：</strong>${item.summary}
        </div>
        <div class="pt-2 text-slate-700 leading-relaxed text-sm sm:text-base">
          <h4 class="font-bold text-slate-900 mb-2">專題解析與建議</h4>
          <p>${item.content}</p>
        </div>
        <div class="mt-4 p-3 bg-teal-50/50 rounded-lg text-xs text-teal-800 border border-teal-100">
          💡 本衛教資訊由「財團法人 RBI 瑞金抗齡照護研究教育基金會」整理，供民眾自我照護與家庭醫療溝通參考，個體治療請務必遵循主治醫師專業處方。
        </div>
      `;

      modal.classList.remove("hidden");
      document.body.classList.add("overflow-hidden");
      lucide.createIcons();
    };

    function closeModal() {
      modal.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
    }

    modalCloseBtn.addEventListener("click", closeModal);
    modalConfirmBtn.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    // 篩選事件處理
    filterButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        filterButtons.forEach(b => {
          b.classList.remove("bg-teal-700", "text-white");
          b.classList.add("bg-white", "text-slate-600");
        });
        btn.classList.remove("bg-white", "text-slate-600");
        btn.classList.add("bg-teal-700", "text-white");

        currentCategory = btn.getAttribute("data-cat");
        renderArticles();
      });
    });

    // 搜尋事件監聽
    searchInput.addEventListener("input", (e) => {
      searchKeyword = e.target.value;
      renderArticles();
    });

    // 手機選單開關
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    mobileMenuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });
    document.querySelectorAll(".mobile-nav-link").forEach(link => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
      });
    });

    // 初始化頁面
    document.addEventListener("DOMContentLoaded", () => {
      renderArticles();
      lucide.createIcons();
    });
  </script>
</body>
</html>
